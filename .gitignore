# StudyGen AI — Git Ignore Configuration

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Virtual environments
.venv/
venv/
ENV/
env/
ENV.bak/
env.bak/

# Environment variables & secrets (CRITICAL: Never commit real keys)
.env
.env.local
.env.*.local
!.env.example

# Local SQLite databases & uploads
*.db
*.db-journal
*.sqlite
*.sqlite3
studygen.db
uploads/

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs & temp files
*.log
logs/
tmp/
temp/
