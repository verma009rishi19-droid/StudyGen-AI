# ==============================================================================
# StudyGen AI — Environment Configuration
# ==============================================================================

# Application Settings
DEBUG=True
SECRET_KEY=studygen-ai-change-this-to-a-secure-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Primary target: PostgreSQL (e.g. postgresql://user:password@localhost:5432/studygen_ai)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studygen_ai
# SQLite fallback is enabled by default to allow instant zero-friction local execution
USE_SQLITE_FALLBACK=True
SQLITE_URL=sqlite:///./studygen.db

# AI Provider Selection
# Primary & Default: 'gemini' (Google Gemini API)
# Alternatives: 'ollama' (Local LLM), 'openai', or 'fallback'
AI_PROVIDER=gemini

# Google Gemini API Configuration (Recommended)
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Ollama Local LLM Configuration (Alternative)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI Cloud LLM Configuration (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Upload Limits
MAX_UPLOAD_SIZE_MB=10
MAX_CONTENT_CHARS=150000
